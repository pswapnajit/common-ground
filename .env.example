# Copy to .env (local) or add these in your host's environment settings.

# --- Qloo -------------------------------------------------------------------
# Hackathon key from the Qloo team. With no key the app uses a small synthetic
# mock of the API so it still runs end to end.
QLOO_API_KEY=
# Hackathon keys only work against this base URL.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# auto = live when QLOO_API_KEY is set, otherwise mock. Or force: live | mock
QLOO_MODE=auto

# --- Language model (the agent) --------------------------------------------
# anthropic (default) | openai (any OpenAI-compatible API) | offline (rule-based planner, no model)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Default model is Claude Opus 5.5. Cheaper options: claude-sonnet-5-5, claude-haiku-5-5
LLM_MODEL=claude-opus-5-5
# low | medium | high  (low keeps the agent fast; thinking is always on for Opus 5.5)
LLM_EFFORT=low

# For LLM_PROVIDER=openai: set all three (OpenAI, Groq, OpenRouter, Together, Ollama...)
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model-name

# --- Limits -----------------------------------------------------------------
# Plans per IP per hour (per server instance). Protects your Qloo quota and model credits.
RATE_LIMIT_PER_HOUR=40
AGENT_MAX_STEPS=8
